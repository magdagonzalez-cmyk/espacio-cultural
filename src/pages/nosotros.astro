---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nosotros">
    <section class="pagina-encabezado">
        <div class="contenedor">
            <span class="etiqueta">Conócenos</span>

            <h1>Sobre Espacio Cultural</h1>

            <p>
                Un lugar creado para fomentar el arte, la creatividad y el
                aprendizaje.
            </p>
        </div>
    </section>

    <section class="seccion">
        <div class="contenedor nosotros">
            <div class="nosotros-imagen">
                <img
                    src="/img/nosotros.jpg"
                    alt="Actividad cultural de Espacio Cultural"
                />
            </div>

            <div class="nosotros-texto">
                <span class="etiqueta">Nuestro propósito</span>

                <h2>Crear, aprender y compartir</h2>

                <p>
                    Espacio Cultural es una organización dedicada a acercar
                    diferentes expresiones artísticas a la comunidad.
                </p>

                <p>
                    Nuestro propósito es crear un lugar donde las personas
                    puedan desarrollar su creatividad, aprender nuevas
                    habilidades y compartir sus experiencias con otros.
                </p>

                <p>
                    A través de nuestros talleres buscamos promover la
                    participación, la expresión artística y el aprendizaje en un
                    ambiente cercano y acogedor.
                </p>
            </div>
        </div>
    </section>
</Layout>
