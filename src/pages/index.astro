---
import Layout from "../layouts/Layout.astro";
import TarjetaTaller from "../components/TarjetaTaller.astro";
---

<Layout title="Inicio">
    <section class="hero">
        <div class="contenedor hero-contenido">
            <div class="hero-texto">
                <span class="etiqueta">Bienvenidos</span>

                <h1>
                    Un lugar para
                    <span>crear y aprender</span>
                </h1>

                <p>
                    En Espacio Cultural creemos que el arte y la creatividad son
                    herramientas para aprender, expresarnos y compartir con los
                    demás.
                </p>

                <a href="/talleres" class="boton"> Ver nuestros talleres </a>
            </div>
        </div>
    </section>

    <section class="seccion">
        <div class="contenedor">
            <div class="titulo-seccion">
                <span class="etiqueta">Conoce nuestras actividades</span>

                <h2>Talleres destacados</h2>

                <p>
                    Descubre algunas de las actividades que tenemos preparadas
                    para nuestra comunidad.
                </p>
            </div>

            <div class="grid-talleres">
                <TarjetaTaller
                    nombre="Fotografía"
                    descripcion="Introducción a la composición y técnicas de fotografía digital."
                    imagen="/img/fotografia.png"
                />

                <TarjetaTaller
                    nombre="Cerámica"
                    descripcion="Creación de objetos utilizando técnicas básicas de modelado."
                    imagen="/img/ceramica.png"
                />

                <TarjetaTaller
                    nombre="Escritura creativa"
                    descripcion="Exploración de relatos breves y ejercicios de escritura."
                    imagen="/img/escritura.png"
                />
            </div>
        </div>
    </section>

    <section class="seccion seccion-destacada">
        <div class="contenedor llamada">
            <div>
                <span class="etiqueta">Espacio Cultural</span>

                <h2>Tu creatividad tiene un lugar</h2>

                <p>
                    Conoce todos nuestros talleres y encuentra una actividad que
                    te inspire.
                </p>
            </div>

            <a href="/talleres" class="boton boton-claro">
                Ver todos los talleres
            </a>
        </div>
    </section>
</Layout>
